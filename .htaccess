# ==========================================
# FleetForce - Reg.ru Hosting .htaccess Configuration
# ==========================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Direct all non-file non-directory requests to index.html for React SPA Routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache-Control headers to prevent caching of dynamic assets and HTML
<IfModule mod_headers.c>
  # Never cache HTML, PHP, or JSON so updates load immediately across all browsers
  <FilesMatch "\.(html|htm|php|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
